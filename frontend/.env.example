# Browser requests stay same-origin and Next.js proxies them to this server-only URL.
COFFER_API_URL=http://127.0.0.1:4000

# Optional public identifier. This is not a Privy secret.
# Configure this origin as an allowed client URL in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=

# NEAR Intents credentials and the factory provisioner key are backend-only.
# Never add either credential under a NEXT_PUBLIC_* name.
