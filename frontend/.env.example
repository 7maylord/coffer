# Browser requests stay same-origin and Next.js proxies them to this server-only URL.
COFFER_API_URL=http://127.0.0.1:4000

# Optional public identifiers. These are not Privy secrets.
# Configure this origin as an allowed client URL in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_APP_CLIENT_ID=
