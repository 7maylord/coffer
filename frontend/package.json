{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "uuid@<11.1.1": "11.1.1",
      "decode-uri-component@<=0.5.0": "0.5.1",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "zod@<4.6.6": "4.6.7"
    }
  },
  "engines": {
    "node": "^22.22.2 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "api:generate": "openapi-typescript ../docs/api/openapi.json -o src/lib/api-schema.d.ts && prettier --write src/lib/api-schema.d.ts",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test --config playwright.fullstack.config.ts"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.11.4",
    "@peerfolio/privy-near-connect": "0.0.8",
    "@privy-io/js-sdk-core": "0.72.1",
    "@privy-io/react-auth": "3.51.0",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/themes": "3.2.1",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "function-call-key-plugin": "2.1.0",
    "near-api-js": "7.4.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "viem": "2.56.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.2",
    "typescript": "6.0.3"
  }
}
