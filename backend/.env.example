# Backend-only local configuration. Copy to backend/.env; never commit secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://coffer:coffer_local@localhost:5433/coffer_dev
REDIS_URL=redis://localhost:6379

# Safe settlement defaults.
SETTLEMENT_MODE=mock
LIVE_TRANSFERS_ENABLED=false
NEAR_TESTNET_TRANSFERS_ENABLED=false
NEAR_INTENTS_DRY_QUOTES_ENABLED=false
NEAR_INTENTS_WET_QUOTES_ENABLED=false
FEATURE_CONFIDENTIAL_SWAPS=false

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_TEST_TOKEN_CONTRACT_ID=ctusd.olymight.testnet
NEAR_TEST_TOKEN_CODE_HASH=9ErFRZL31aDUPy6nBfztaCySidVzZsZsoyqP5x9NoM12
NEAR_POLICY_FACTORY_ACCOUNT_ID=factory.olymight.testnet
NEAR_POLICY_FACTORY_CODE_HASH=E39mq9jbJTMyqK82oxsGks78bw5n7JpmCxz1cC1RroLZ
NEAR_POLICY_PROVISIONER_ACCOUNT_ID=olymight.testnet
NEAR_POLICY_CODE_HASH=EtQLEkEdF82iifMe68RdFBYC4YWPh3oGMskuM2w7AhJj

# Use `tidepool` with https://www.usetidepool.tech for testnet-only quotes.
# Wallet-signed execution additionally requires LIVE_TRANSFERS_ENABLED,
# NEAR_TESTNET_TRANSFERS_ENABLED and NEAR_INTENTS_WET_QUOTES_ENABLED.
# Obtain one partner JWT from https://partners.near-intents.org and put it in
# only one field. API_KEY sends X-API-Key; JWT sends Authorization: Bearer.
NEAR_INTENTS_PROVIDER=one-click
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=
NEAR_INTENTS_JWT=

NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
NEAR_AI_CFO_ENABLED=false
AI_CFO_PROVIDER=mock
STRICT_TEE_ATTESTATION=true
ENCRYPTION_KEY_BASE64=
ENCRYPTION_KEY_VERSION=local-v1

FEATURE_NATIVE_POLICY_CONTRACT=false
FEATURE_AGENT_EXECUTION=false
FEATURE_PRIVATE_AI=false
PRIVATE_AI_PROVIDER=unavailable
FEATURE_PAYROLL_BATCH_PAYOUT=false
FEATURE_MULTI_TENANT_BILLING=false
