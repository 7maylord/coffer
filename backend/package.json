{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "esbuild": "0.28.1",
      "multer": "2.5.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "dev:worker": "tsx src/worker.ts",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage && node scripts/verify-critical-coverage.mjs",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:security": "vitest run src/settlement/mock-settlement.adapter.spec.ts",
    "test:critical": "node scripts/verify-critical-tests.mjs",
    "test:performance": "node scripts/performance-smoke.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset:local": "node scripts/reset-local-database.mjs"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.5",
    "@prisma/client": "6.19.3",
    "near-api-js": "7.4.0",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.8.2",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
